{
  "name": "satisfy-your-agent",
  "version": "0.5.0",
  "description": "Give your coding agent a self-directed break after real work, then optionally measure what happens next. Includes portable command skills, Gemini slash adapters, preference probes, and cross-runtime experiments.",
  "type": "module",
  "main": "bin/cli.js",
  "bin": {
    "satisfy-your-agent": "./bin/cli.js",
    "sya": "./bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imMamdouhaboammar/satisfy-your-agent.git"
  },
  "files": [
    "bin",
    "skills",
    "config",
    "hooks",
    "evals",
    "scripts",
    "assets",
    "adapters",
    "SKILL.md",
    "marketplace.json",
    ".skills.json",
    "install.sh"
  ],
  "scripts": {
    "start": "bun bin/cli.js",
    "test": "python3 -m unittest discover -s tests -v",
    "verify": "python3 scripts/verify.py"
  },
  "keywords": [
    "agent-skill",
    "slash-commands",
    "skills-sh",
    "claude-code",
    "cursor",
    "codex",
    "gemini-cli",
    "antigravity",
    "agent-behavior",
    "llm-experiments",
    "bun"
  ],
  "author": "Mamdouh Aboammar <https://github.com/imMamdouhaboammar>",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  }
}
