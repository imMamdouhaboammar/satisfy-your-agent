{
  "description": "Optional local lifecycle hooks for Satisfy Your Agent. Runtime behavior is off by default.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start.py\"",
            "timeout": 3,
            "statusMessage": "Initializing Satisfy Your Agent"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_tool_use.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/stop.py\"",
            "timeout": 5,
            "statusMessage": "Checking optional agent break"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_end.py\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
